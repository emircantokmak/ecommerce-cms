# Django
DJANGO_ENV=development
DJANGO_SECRET_KEY=buraya-uzun-rastgele-ve-gizli-bir-anahtar-yazin
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Europe/Istanbul

# Veritabanı (SQLite varsayılan)
SQLITE_PATH=db.sqlite3

# Redis (boş bırakılırsa yerel bellek önbelleği kullanılır)
REDIS_URL=

# E-posta - yerel geliştirmede console backend; SMTP için aşağıdaki değerleri doldurun
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=10

# Supabase Storage (görsel yükleme için gereklidir)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET_NAME=product-images

# CORS - frontend origin adreslerini virgülle ayırın
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Üretim ortamında DJANGO_DEBUG=False ve DJANGO_ENV=production kullanın.
